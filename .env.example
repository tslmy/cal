# Leave CRUSOE_API_KEY empty to run the designer in offline mock mode.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Optional model overrides. The server checks them against GET /v1/models on start
# and swaps in the closest Nemotron it serves, so these can usually stay commented out.
# MODEL_DESIGNER=nvidia/Nemotron-3.5-Lightning-30B-A3B
# MODEL_PLANNER=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# MODEL_OBSERVER=nvidia/Nemotron-3.5-Lightning-30B-A3B
# MODEL_ROUTER=nvidia/Nemotron-3-Nano-30B-A3B
DESIGNER_DRAFTS=3
DESIGNER_REPAIRS=2
# Model calls in flight at once per model (Crusoe limits requests per model).
DESIGNER_CONCURRENCY=2
# Set to 1 to let Nemotron reason before answering (slower, can run out of tokens).
DESIGNER_THINKING=0
# Imported .ics and email times are converted to this zone (the app stores wall-clock times).
# EVOLVE_TZ=America/Los_Angeles
